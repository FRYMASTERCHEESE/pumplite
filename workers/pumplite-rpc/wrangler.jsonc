// No secrets in this file. Deployment is manual and separately approved.
{
  "name": "pumplite-rpc",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "preview_urls": false,
  "services": [
    {
      "binding": "UPLOAD_GUARD",
      "service": "pumplite-upload-guard"
    }
  ],
  "vars": {
    "METADATA_UPLOADS_ENABLED": "true",
    "METADATA_AUTH_ENABLED": "true"
  }
}
