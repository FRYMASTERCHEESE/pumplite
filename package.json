{
  "name": "pumplite",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build:contracts": "node scripts/compile-base.mjs && node scripts/compile-base-v2.mjs",
    "build": "node scripts/compile-base.mjs && node scripts/compile-base-v2.mjs && node scripts/build.mjs",
    "test": "node scripts/compile-base.mjs && node scripts/compile-base-v2.mjs && node scripts/compile-plite-holder-claim.mjs && node --test tests/*.test.mjs",
    "test:base": "node scripts/compile-base.mjs && node --test tests/base.test.mjs",
    "check": "node scripts/check.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "node tests/browser.mjs",
    "build:pages": "node scripts/build.mjs",
    "check:pages": "node scripts/build.mjs --check",
    "test:pages": "node tests/pages.mjs",
    "test:base-v2": "node scripts/compile-base-v2.mjs && node --test tests/base-v2.test.mjs",
    "prepare:base-v2-release": "node scripts/compile-base.mjs && node scripts/compile-base-v2.mjs && node scripts/prepare-base-v2-release.mjs",
    "test:base-v2-release": "node scripts/compile-base.mjs && node scripts/compile-base-v2.mjs && node scripts/prepare-base-v2-release.mjs && node --test tests/base-v2-release.test.mjs",
    "verify:base-v2-live": "node scripts/compile-base-v2.mjs && node scripts/verify-base-v2-live.mjs",
    "verify:base-production": "node scripts/compile-base-v2.mjs && node scripts/compile-plite-holder-claim.mjs && node scripts/verify-base-production.mjs",
    "verify:base-markets": "node scripts/compile-base-v2.mjs && node scripts/verify-base-markets.mjs",
    "verify:base-rpc-health": "node scripts/verify-base-rpc-health.mjs",
    "verify:base-economic-health": "node scripts/compile-base-v2.mjs && node scripts/verify-base-economic-health.mjs",
    "verify:base-write-sim": "node scripts/compile-base-v2.mjs && node scripts/verify-base-write-sim.mjs",
    "verify:base-event-accounting": "node scripts/compile-base-v2.mjs && node scripts/verify-base-event-accounting.mjs",
    "verify:plite-dex-health": "node scripts/verify-plite-dex-health.mjs",
    "verify:metadata-health": "node scripts/verify-metadata-health.mjs",
    "verify:base-privileged-actions": "node scripts/compile-base-v2.mjs && node scripts/verify-base-privileged-actions.mjs",
    "verify:base-trade-provenance": "node scripts/compile-base-v2.mjs && node scripts/verify-base-trade-provenance.mjs",
    "verify:hardening-19-27": "node scripts/compile-base-v2.mjs && node scripts/compile-plite-holder-claim.mjs && node scripts/verify-hardening-19-27.mjs",
    "verify:public-site": "node scripts/verify-public-site.mjs",
    "build:claim": "node scripts/compile-base-v2.mjs && node scripts/compile-plite-holder-claim.mjs",
    "test:claim": "node scripts/compile-base-v2.mjs && node scripts/compile-plite-holder-claim.mjs && node --test tests/plite-holder-claim.test.mjs",
    "verify:hardening-28-50": "node scripts/verify-hardening-28-50.mjs",
    "verify:hardening-401-1000": "node scripts/verify-hardening-401-1000.mjs",
    "verify:token-verification-1001-5000": "node scripts/verify-token-verification-1001-5000.mjs"
  },
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "0.2.64-alpha",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "buffer": "6.0.3",
    "ethers": "6.15.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "esbuild": "0.25.5",
    "ganache": "7.9.2",
    "playwright": "1.62.1",
    "solc": "0.8.30"
  }
}
