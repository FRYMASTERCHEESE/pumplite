{
  "name": "pumplite",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build:contracts": "node scripts/compile-base.mjs",
    "build": "node scripts/compile-base.mjs && node scripts/build.mjs",
    "test": "node scripts/compile-base.mjs && node --test tests/*.test.mjs",
    "test:base": "node scripts/compile-base.mjs && node --test tests/base.test.mjs",
    "check": "node scripts/check.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3",
    "ethers": "6.15.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "esbuild": "0.25.5",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "playwright": "1.62.1"
  }
}
